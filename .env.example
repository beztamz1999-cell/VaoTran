# PostgreSQL connection string. Never commit a real password.
DATABASE_URL=postgresql://vaotran:change-me@127.0.0.1:5432/vaotran

# HTTP service configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Browser origins allowed to call this API. Use comma-separated exact origins;
# set local Expo Web and your LAN Expo Web origin for private-alpha development.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://192.168.x.x:8081

# Private-alpha authentication. Bearer tokens are opaque server-side sessions.
AUTH_SESSION_TTL_DAYS=30
# DEV/TEST ONLY. Keep false for private alpha and production.
ALLOW_DEV_ACTOR_HEADER=false

# Retention window for successful critical-write command responses.
IDEMPOTENCY_TTL_HOURS=24

# Internal scheduler interval for auto-starting due OPEN/FULL Rooms.
AUTO_START_INTERVAL_MS=60000

# M4 Search & Discovery read-side configuration. These values never alter Room capacity or lifecycle facts.
SEARCH_RANKING_CONFIG_VERSION=m4-v0.1
SEARCH_DEFAULT_RADIUS_KM=5
SEARCH_EXPANDED_RADIUS_1_KM=10
SEARCH_EXPANDED_RADIUS_2_KM=20
SEARCH_MIN_RESULTS_BEFORE_EXPAND=3
SEARCH_MAX_RESULTS=50
SEARCH_WEIGHT_PROXIMITY=25
SEARCH_WEIGHT_TIME=20
SEARCH_WEIGHT_CAPACITY=15
SEARCH_WEIGHT_SKILL=15
SEARCH_WEIGHT_RELATIONSHIP=10
SEARCH_WEIGHT_RELIABILITY=5
SEARCH_WEIGHT_URGENCY=10

# M5 HOST-protection: maximum window after Room start where a HOST may accept an emergency replacement.
EMERGENCY_REPLACEMENT_WINDOW_MINUTES=30
